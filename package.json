{
  "name": "alfa-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "predev": "node scripts/generate-sw.mjs --dev",
    "build": "next build",
    "prebuild": "node scripts/generate-sw.mjs",
    "start": "next start -p 80",
    "start:e2e": "next start -p 3100",
    "lint": "eslint app context lib utils proxy.js next.config.mjs",
    "test": "jest --runInBand",
    "pretest": "node scripts/generate-route-manifest.mjs && node scripts/generate-sw.mjs",
    "routes:manifest": "node scripts/generate-route-manifest.mjs",
    "pwa:generate": "node scripts/generate-sw.mjs",
    "pwa:check": "node scripts/generate-sw.mjs --check",
    "pwa:assets": "powershell -ExecutionPolicy Bypass -File scripts/generate-pwa-assets.ps1",
    "seo:validate": "node scripts/validate-seo.mjs",
    "seo:warm-images": "node scripts/warm-images.mjs",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "npm run build && playwright test -c playwright.pwa.config.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@tanstack/react-table": "^8.21.3",
    "aos": "^2.3.4",
    "axios": "^1.21.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.0.5",
    "sharp": "^0.35.5",
    "sweetalert2": "^11.26.17",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "25.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mailparser": "^3.14.1",
    "postcss": "^8.5.32",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  }
}
